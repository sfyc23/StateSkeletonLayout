# ============================================================
# StateSkeletonLayout .gitignore
# 用法说明：
#  - 按分组管理，修改时请放到对应分组下，并补充注释
#  - 带 `/` 表示仅匹配目录；`**/` 表示递归匹配
# 文件编码请保持 UTF-8
# ============================================================

# ---------- 1. 构建产物 / Gradle ----------
# Gradle 本地缓存（自动生成，可删除重建）
.gradle/
# 各模块及根目录构建输出（apk / aab / class / 生成代码等）
build/
**/build/
# NDK / CMake 外部构建目录
.externalNativeBuild/
.cxx/
# 兜底：即使有人改输出路径，产物也不入库
*.apk
*.aab
*.aar
# Android Studio 抓取的性能快照、堆转储（体积大，无需入库）
captures/
*.hprof

# ---------- 2. 本地配置（每台机器不同，不入库） ----------
# SDK 路径、本地覆盖配置
local.properties
# 签名配置文件（可能含密码路径，按需本地创建）
keystore.properties

# ---------- 3. IDE 与工具缓存 ----------
# Android Studio / IntelliJ 工程配置
.idea/
*.iml
# Kotlin 增量编译 / IDE 索引缓存
.kotlin/
# 华为 CodeArts / 其他云端 IDE 本地状态
.codeartsdoer/

# ---------- 4. 签名密钥（绝不提交） ----------
# 本地签名文件及配置
*.jks
*.keystore

# ---------- 5. 操作系统与临时文件 ----------
# macOS 文件夹属性缓存
.DS_Store

# ---------- 6. 项目私有文档（过程稿，不随源码发布） ----------
# 内部设计 / 方案 / 验证记录等过程文档
docs/
