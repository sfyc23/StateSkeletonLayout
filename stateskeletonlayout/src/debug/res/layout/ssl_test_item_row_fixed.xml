<?xml version="1.0" encoding="utf-8"?>
<!-- Test fixture: fixed-size mirror of ssl_test_item_row for handwritten T1 templates.
     Same structure, but the two text bars are fixed-size Views so the template
     needs no binder. Used to compare T1 vs T2 assembly row-for-row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="160dp"
            android:layout_height="16dp" />

        <View
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
