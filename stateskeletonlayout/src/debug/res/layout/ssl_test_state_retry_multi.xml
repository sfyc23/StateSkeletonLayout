<?xml version="1.0" encoding="utf-8"?>
<!-- Robolectric 测试夹具：多入口状态页，含 EMPTY 与 ERROR 各自的两个不同 ID。
     同一份布局同时用于 EMPTY / ERROR，验证同一布局中不同状态只绑定各自列表。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ssl_test_multi_empty_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="empty-image" />

    <TextView
        android:id="@+id/ssl_test_multi_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="empty-text" />

    <Button
        android:id="@+id/ssl_test_multi_error_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="error-image" />

    <Button
        android:id="@+id/ssl_test_multi_error_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="error-button" />

</LinearLayout>
