<?xml version="1.0" encoding="utf-8"?>
<!-- Test fixture: text-only row with no fixed-size views.
     Without binder both TextViews measure 0, so the row yields no geometry
     and T2 preflight must fail fast; with binder filling text it passes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ssl_test_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ssl_test_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

</LinearLayout>
