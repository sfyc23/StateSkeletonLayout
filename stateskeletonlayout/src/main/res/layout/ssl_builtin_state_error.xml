<?xml version="1.0" encoding="utf-8"?>
<!--
  库内置错误态布局：宿主未配置 ssl_errorLayout 时的兜底页面。

  重试按钮 ID 固定为 ssl_builtin_state_retry；未显式配置 ssl_errorRetryViewId 时，
  控件会自动把它作为统一重试入口绑定，宿主无需再配置。

  按钮用 android.widget.Button 而非 MaterialButton，保持零额外依赖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ssl_builtin_state_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/ssl_builtin_state_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/ssl_builtin_error_message"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/ssl_builtin_state_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minWidth="96dp"
        android:text="@string/ssl_builtin_retry" />

</LinearLayout>
