<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="com.sfyc.demo.DemoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/demo_data_extraction_rules"
        android:fullBackupContent="@xml/demo_backup_rules"
        android:icon="@mipmap/demo_ic_launcher"
        android:label="@string/demo_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StateSkeletonDemo">
        <activity
            android:name="com.sfyc.demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
