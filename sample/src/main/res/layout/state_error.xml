<?xml version="1.0" encoding="utf-8"?>
<!-- 示例错误页：重试按钮有效触控区域不小于 48dp x 48dp（minWidth/minHeight）。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/demo_state_error_title"
        android:textColor="@color/demo_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/demo_state_error_desc"
        android:textColor="@color/demo_text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/demo_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="@string/demo_state_retry" />

</LinearLayout>
