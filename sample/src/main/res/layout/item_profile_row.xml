<?xml version="1.0" encoding="utf-8"?>
<!-- 列表示例的业务行：标题 + 副标题（本地假数据）。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/demo_card"
    android:orientation="horizontal"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/demo_avatar_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/demo_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/demo_text_primary"
            android:textSize="16sp"
            tools:text="演示条目 1" />

        <TextView
            android:id="@+id/demo_row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/demo_row_subtitle"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
