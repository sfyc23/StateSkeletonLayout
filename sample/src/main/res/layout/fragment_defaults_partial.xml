<?xml version="1.0" encoding="utf-8"?>
<!-- 部分覆盖示例：全局默认仅声明两字段，未声明字段回落库内置默认。 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_defaults_partial_hint"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/demo_config_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="config summary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_defaults_instance_l"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/demo_container_l"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="4dp"
            android:background="@color/demo_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_defaults_instance_r"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/demo_container_r"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="4dp"
            android:background="@color/demo_card" />

        <Button
            android:id="@+id/demo_btn_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/demo_defaults_btn_full" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_defaults_instance_c"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/demo_container_c"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="4dp"
            android:background="@color/demo_card" />

        <TextView
            android:id="@+id/demo_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="11sp"
            android:typeface="monospace"
            tools:text="compare" />

        <TextView
            android:id="@+id/demo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_secondary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="log" />

    </LinearLayout>

</ScrollView>
