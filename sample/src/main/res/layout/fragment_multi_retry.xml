<?xml version="1.0" encoding="utf-8"?>
<!-- 多重试入口示例宿主：两个独立局部实例，只刷新各自内容。 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_multi_hint"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <com.sfyc.ssl.StateSkeletonLayout
            android:id="@+id/demo_state_a"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            app:ssl_emptyLayout="@layout/demo_state_empty_retry"
            app:ssl_errorLayout="@layout/demo_state_error_retry"
            app:ssl_emptyRetryViewIds="@array/demo_multi_empty_retry_ids"
            app:ssl_errorRetryViewIds="@array/demo_multi_error_retry_ids">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/demo_card"
                android:gravity="center"
                android:text="@string/demo_btn_content"
                android:textColor="@color/demo_text_primary"
                android:textSize="18sp" />

        </com.sfyc.ssl.StateSkeletonLayout>

        <com.sfyc.ssl.StateSkeletonLayout
            android:id="@+id/demo_state_b"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            app:ssl_emptyLayout="@layout/demo_state_empty_retry"
            app:ssl_errorLayout="@layout/demo_state_error_retry"
            app:ssl_emptyRetryViewIds="@array/demo_multi_empty_retry_ids"
            app:ssl_errorRetryViewIds="@array/demo_no_retry_ids">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/demo_card"
                android:gravity="center"
                android:text="@string/demo_btn_content"
                android:textColor="@color/demo_text_primary"
                android:textSize="18sp" />

        </com.sfyc.ssl.StateSkeletonLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demo_btn_empty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_empty" />

            <Button
                android:id="@+id/demo_btn_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_error" />

            <Button
                android:id="@+id/demo_btn_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_multi_btn_toggle" />

        </LinearLayout>

        <TextView
            android:id="@+id/demo_retry_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp"
            tools:text="重试：A=0 B=0" />

        <TextView
            android:id="@+id/demo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_secondary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="log" />

    </LinearLayout>

</ScrollView>
