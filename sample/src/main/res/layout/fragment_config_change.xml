<?xml version="1.0" encoding="utf-8"?>
<!--
  配置变更示例：昼夜 / 字体缩放 / RTL / locale 四项 Configuration 变更的观察页。

  摘要区实时显示当前 resources.configuration 的四个维度，以及骨架当前的 maskColor，
  便于对比「重建前 → 重建后」的结果。
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_config_hint"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <com.sfyc.ssl.StateSkeletonLayout
            android:id="@+id/demo_state"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp"
            app:ssl_emptyLayout="@layout/state_empty"
            app:ssl_errorLayout="@layout/state_error"
            app:ssl_errorRetryViewIds="@array/demo_single_retry_ids"
            app:ssl_useSkeleton="true"
            app:ssl_skeletonEffect="shimmer"
            app:ssl_skeletonSource="template"
            app:ssl_skeletonTemplate="@layout/skeleton_profile_template">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/demo_card"
                android:gravity="center"
                android:text="@string/demo_btn_content"
                android:textColor="@color/demo_text_primary"
                android:textSize="18sp" />

        </com.sfyc.ssl.StateSkeletonLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demo_btn_loading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_loading" />

            <Button
                android:id="@+id/demo_btn_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_content" />

            <Button
                android:id="@+id/demo_btn_empty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_empty" />

            <Button
                android:id="@+id/demo_btn_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_error" />

        </LinearLayout>

        <TextView
            android:id="@+id/demo_config_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="configuration" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demo_btn_toggle_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/demo_config_btn_toggle_night" />

            <Button
                android:id="@+id/demo_btn_recreate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/demo_config_btn_recreate" />

        </LinearLayout>

        <TextView
            android:id="@+id/demo_config_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_config_note"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/demo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_secondary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="log" />

    </LinearLayout>

</ScrollView>
