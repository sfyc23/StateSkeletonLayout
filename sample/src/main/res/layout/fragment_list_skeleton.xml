<?xml version="1.0" encoding="utf-8"?>
<!--
  整屏列表骨架示例：一个 StateSkeletonLayout 覆盖整屏多行，而不是每个 item 一个实例。

  模板用 app:ssl_skeletonSource="template" 指向 skeleton_list_rows_template，
  模板内静态重复 8 行形状，与业务列表的 Adapter 完全解耦。
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_list_skeleton_hint"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <com.sfyc.ssl.StateSkeletonLayout
            android:id="@+id/demo_state"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="12dp"
            app:ssl_emptyLayout="@layout/state_empty"
            app:ssl_errorLayout="@layout/state_error"
            app:ssl_errorRetryViewId="@id/demo_retry"
            app:ssl_useSkeleton="true"
            app:ssl_skeletonEffect="shimmer"
            app:ssl_skeletonSource="template"
            app:ssl_skeletonTemplate="@layout/skeleton_list_rows_template">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/demo_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:background="@color/demo_card"
                tools:itemCount="8"
                tools:listitem="@layout/item_profile_row" />

        </com.sfyc.ssl.StateSkeletonLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demo_btn_loading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_loading" />

            <Button
                android:id="@+id/demo_btn_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_content" />

            <Button
                android:id="@+id/demo_btn_empty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_empty" />

            <Button
                android:id="@+id/demo_btn_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_btn_error" />

        </LinearLayout>

        <TextView
            android:id="@+id/demo_list_skeleton_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_list_skeleton_note"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/demo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_secondary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="log" />

    </LinearLayout>

</ScrollView>
