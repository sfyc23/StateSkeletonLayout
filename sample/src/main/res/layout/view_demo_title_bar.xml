<?xml version="1.0" encoding="utf-8"?>
<!-- 二级页标题栏：固定在内容上方，不放进 ScrollView。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/demo_page_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/demo_page_back"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/demo_ic_arrow_back" />

    <TextView
        android:id="@+id/demo_page_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/demo_text_primary"
        android:textSize="18sp" />

</LinearLayout>
