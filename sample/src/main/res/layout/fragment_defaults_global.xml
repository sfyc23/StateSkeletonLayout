<?xml version="1.0" encoding="utf-8"?>
<!-- 全局默认与程序化创建示例：install 全字段覆盖 → 程序化创建实例；再次 install 验证整体替换。 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_defaults_global_hint"
            android:textColor="@color/demo_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/demo_config_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="config summary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_defaults_instance_a"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/demo_container_a"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:background="@color/demo_card" />

        <Button
            android:id="@+id/demo_btn_install_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/demo_defaults_btn_install_b" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_defaults_instance_b"
            android:textColor="@color/demo_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/demo_container_b"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:background="@color/demo_card" />

        <TextView
            android:id="@+id/demo_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_primary"
            android:textSize="11sp"
            android:typeface="monospace"
            tools:text="compare" />

        <TextView
            android:id="@+id/demo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/demo_card"
            android:padding="8dp"
            android:textColor="@color/demo_text_secondary"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:text="log" />

    </LinearLayout>

</ScrollView>
