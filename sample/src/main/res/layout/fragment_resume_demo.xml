<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/resume_hint"
        android:textColor="@color/demo_text_secondary"
        android:textSize="13sp" />

    <com.airbnb.epoxy.EpoxyRecyclerView
        android:id="@+id/resume_epoxy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:saveEnabled="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resume_candidate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/resume_reload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/resume_reload_work"
                    android:textSize="12sp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/resume_scenario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/resume_latency_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/resume_latency_100"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/network_latency_100"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/resume_latency_600"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="600 ms"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/resume_latency_1500"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/network_latency_1500"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/resume_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="@color/demo_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/resume_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/demo_card"
                android:maxLines="5"
                android:padding="8dp"
                android:textColor="@color/demo_text_secondary"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
