<?xml version="1.0" encoding="utf-8"?>
<!-- 示例空内容页：布局内部自行居中，触控区域满足 48dp 要求（本页无按钮，仅展示）。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/demo_state_empty_title"
        android:textColor="@color/demo_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/demo_state_empty_desc"
        android:textColor="@color/demo_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
