<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 单元素共享引用：存量示例统一重试入口迁移为数组声明。 -->
    <array name="demo_single_retry_ids">
        <item>@id/demo_retry</item>
    </array>

    <!-- 多入口示例：空态图片 + 文字，错误态图片 + 按钮。 -->
    <array name="demo_multi_empty_retry_ids">
        <item>@id/demo_empty_image</item>
        <item>@id/demo_empty_text</item>
    </array>
    <array name="demo_multi_error_retry_ids">
        <item>@id/demo_error_image</item>
        <item>@id/demo_error_retry</item>
    </array>

    <!-- 显式关闭：空数组是有效配置。 -->
    <array name="demo_no_retry_ids" />
</resources>
